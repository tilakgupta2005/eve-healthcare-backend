# Copy this file to .env and adjust as needed.

# Postgres (docker-compose): postgresql+psycopg2://eve:eve@db:5432/eve_healthcare
# Local quick start (SQLite):
DATABASE_URL=sqlite:///./eve_healthcare.db

SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Probability (0-1) a simulated payment succeeds when force_status is not passed.
PAYMENT_SUCCESS_RATE=0.8
